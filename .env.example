# Heritage Ring — variabili d'ambiente (COPIA in .env e riempi i valori)
# .env NON va mai committato (è in .gitignore).

# ---- Shopify (client credentials grant, NON token statico shpat_) ----
SHOPIFY_STORE=fx8bnw-ix.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-04

# ---- Supabase (Postgres) ----
SUPABASE_URL=
SUPABASE_KEY=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Anthropic (solo linguaggio naturale, MAI per i numeri) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Meta (Fase 2, SOLA LETTURA: ads_read + read_insights) ----
# System User token (Business Manager). MAI ads_management.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v21.0

# ---- Klaviyo (Fase 4, SOLA LETTURA: solo CAMPAGNE, NO flows) ----
# Private API key pk_... (read-only). Una sola chiamata Reporting API al giorno.
KLAVIYO_API_KEY=
KLAVIYO_API_REVISION=2024-10-15
# Opzionale: ID della metrica "Placed Order" (altrimenti risolto a runtime).
KLAVIYO_CONVERSION_METRIC_ID=

# ---- Opzionale ----
TIMEZONE=Europe/Rome

# ---- Railway (solo sul servizio CRON) ----
# Con la guardia attiva il report parte solo a mezzanotte Europe/Rome.
# Cron Schedule su Railway (UTC): 0 22,23 * * *
RAILWAY_CRON_GUARD=
